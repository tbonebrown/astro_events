APP_NAME=Astro Event Intelligence
APP_ENV=development
DATABASE_URL=sqlite:///./var/astro_events.db
DATA_DIR=./var/data
EXPORTS_DIR=./exports
STATIC_DIR=./services/web/dist
LOCAL_INFERENCE_URL=http://127.0.0.1:11434/api/generate
LOCAL_INFERENCE_MODEL=astro-explainer
LOCAL_INFERENCE_PROVIDER=ollama
EXOPLANET_CACHE_DIR=./var/data/exoplanet
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=astro-explainer
USE_GPU_CLASSIFIER=true
GPU_DEVICE=cuda:0
ROCM_DEVICE=hip:0
MAX_WORKERS=4
NASA_ARCHIVE_TIMEOUT=8
ENABLE_BATCH_SCAN=true
DEFAULT_SECTOR=58
PUBLIC_HOSTS=ohnita.com,www.ohnita.com
FORCE_HTTPS=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
TESS_TARGET_FILE=./data/tic_targets.csv
TESS_TARGET_URL=
TESS_TARGET_SERVER_PATH=
TESS_TARGET_OUTPUT=./var/data/tic_targets.csv
TESS_TARGET_CATALOG=ctl
TESS_TARGET_LIMIT=500
TESS_TARGET_MIN_TMAG=8
TESS_TARGET_MAX_TMAG=13
TESS_TARGET_MIN_TEFF=3500
TESS_TARGET_MAX_TEFF=7500
TESS_TARGET_MIN_LOGG=4.1
TESS_TARGET_MAX_LOGG=5.2
GAIA_ALERTS_URL=https://gsaweb.ast.cam.ac.uk/alerts/alertsindex
GAIA_ALERTS_LIMIT=100
GAIA_SOURCE_NAME=gaia
TRANSIENT_REPORT_TOP_K=12
SYNC_TARGET=
SYNC_MODE=local
API_BASE_URL=http://127.0.0.1:8000
API_HOST_PORT=8010
